{
  "name": "foundry-keeper",
  "version": "0.1.0",
  "description": "Self-improvement: unified operation log + monthly summariser",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/foundry-log.py\""
          }
        ]
      }
    ]
  }
}
